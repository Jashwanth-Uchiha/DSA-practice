// leet code 1614 maximum depth of parenthesis
class Solution
{
public:
    int maxDepth(string s)
    {
        int depth = 0;
        int k = 0;
        for (int i = 0; i < s.length(); i++)
        {
            if (s[i] == '(')
            {
                depth++;
                k = max(depth, k);
            }
            if (s[i] == ')')
            {
                depth--;
            }
        }
        return k;
    }
};